\#
    === class InMemoryStudentsRepository ===
        === Comments ===
   @Override
     public List<Student> findAll(){
        List<Student> students=new ArrayList<>(studentsById.values());
        return students;
    }
   @Override
     public boolean deleteById(int id){
        if(studentsById.remove(id)!=null){
            return true;
        }
        return false;
    }
   @Override
     public boolean add(Student student) {
        if (student == null) throw new
                IllegalArgumentException("Student cannot be null!!");
        studentsById.put(student.getId(), student);//اضافة الطالب باستخدام ال id كمفتاح
    }
#/


